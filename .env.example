# Copy to .env and fill in real values. .env is gitignored.

# ── Database ─────────────────────────────────────────────────────────────
# Local dev (docker postgres) example:
#   postgresql+psycopg://postgres:postgres@localhost:5432/linh_news
# On Fly.io, set this from `fly postgres attach`.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/linh_news

# ── Anthropic ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Google OAuth (used for both user login and calendar refresh token) ───
# Create a Web Application OAuth client at https://console.cloud.google.com/
# Authorized redirect URI: ${PUBLIC_BASE_URL}/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public base URL (no trailing slash). Used as the OAuth redirect base.
# Local dev: http://localhost:8000
# Production: https://linh-news.fly.dev
PUBLIC_BASE_URL=http://localhost:8000

# ── Weather (Woodcliff Lake, NJ) ─────────────────────────────────────────
WEATHER_COORDS=41.0223,-74.0635
WEATHER_ADDRESS=15 Hunter Ridge, Woodcliff Lake, NJ 07677

# ── Authorized users ─────────────────────────────────────────────────────
# Comma-separated Google account emails allowed to view the site. The admin
# email must be included here too. To grant or revoke access, update this
# value and redeploy (`fly secrets set AUTHORIZED_USERS=…`).
AUTHORIZED_USERS=vtlinh87@gmail.com
# Sole admin (Hide buttons, important events, movie admin). Must also appear
# in AUTHORIZED_USERS.
ADMIN_EMAIL=vtlinh87@gmail.com

# ── Session cookie signing ───────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_TTL_DAYS=30

# ── TMDB (movie posters for /admin/movies) ───────────────────────────────
# Free key from https://www.themoviedb.org/settings/api. If unset, the
# Movies admin page falls back to whatever poster URL Claude returned.
TMDB_API_KEY=
